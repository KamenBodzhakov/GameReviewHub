@using GameReviewHub.ViewModels.Game
@model GameReviewHub.ViewModels.Game.AllGamesQueryModel
@{
    ViewData["Title"] = "All Games";
    var genres = (IEnumerable<GameGenreOptionViewModel>)ViewData["Genres"]!;
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<form id="games-filter-form" method="get" asp-action="Index" class="mb-4">
    <div class="row g-2">
        <div class="col-md-6">
            <input asp-for="SearchTerm"
                   id="live-search-input"
                   class="form-control"
                   placeholder="Search games..." />
        </div>

        <div class="col-md-4">
            <select asp-for="GenreId" class="form-select">
                <option value="">All genres</option>

                @foreach (var genre in genres)
                {
                    <option value="@genre.Id">@genre.Name</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                Show Results
            </button>
        </div>
    </div>
</form>

<div id="games-results">
    <partial name="_GamesResultsPartial" model="Model" />
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const STORAGE_KEY = "games_filters";

            const form = document.getElementById("games-filter-form");
            const searchInput = document.getElementById("live-search-input");
            const genreSelect = document.getElementById("GenreId");
            const resultsContainer = document.getElementById("games-results");

            let debounceTimer;

            async function loadResults() {
                const formData = new FormData(form);
                formData.set("CurrentPage", "1");

                const dataToStore = {
                    searchTerm: formData.get("SearchTerm"),
                    genreId: formData.get("GenreId")
                };

                localStorage.setItem(STORAGE_KEY, JSON.stringify(dataToStore));

                const query = new URLSearchParams(formData).toString();
                const url = `/Games/GetFilteredPagedGames?${query}`;

                const response = await fetch(url);

                if (!response.ok) {
                    return;
                }

                const html = await response.text();
                resultsContainer.innerHTML = html;
            }

            const saved = localStorage.getItem(STORAGE_KEY);

            if (saved) {
                const data = JSON.parse(saved);

                if (data.searchTerm) {
                    searchInput.value = data.searchTerm;
                }

                if (data.genreId) {
                    genreSelect.value = data.genreId;
                }

                loadResults();
            }

            form.addEventListener("submit", async function (e) {
                e.preventDefault();
                await loadResults();
            });

            searchInput.addEventListener("input", function () {
                clearTimeout(debounceTimer);

                debounceTimer = setTimeout(async function () {
                    await loadResults();
                }, 300);
            });

            genreSelect.addEventListener("change", async function () {
                await loadResults();
            });
        });
    </script>
}