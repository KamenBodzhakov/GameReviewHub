@using GameReviewHub.ViewModels.Game
@model GameDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container d-flex justify-content-center">
    <div class="col-lg-8 col-md-10">

        <div class="card shadow-sm p-4">

            <h2 class="mb-3 text-center fw-bold">@Model.Title</h2>

            <div class="mb-3 text-muted text-center">
                <strong>Developer:</strong> @Model.Developer <br />
                <strong>Release Date:</strong> @Model.ReleaseDate.ToString("yyyy-MM-dd")
            </div>

            <p class="fs-5 text-center">
                @Model.Description
            </p>

            @if (Model.Genres.Any())
            {
                <h5 class="mt-4 text-center">Genres</h5>

                <div class="mb-4 text-center">
                    @foreach (var genre in Model.Genres)
                    {
                        <span class="badge bg-primary me-1">@genre</span>
                    }
                </div>
            }

            <div class="text-center">
                <a asp-controller="Games"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    ← Back to Games
                </a>
            </div>

        </div>

    </div>
</div>