@using GameReviewHub.ViewModels.Game
@model IEnumerable<GameListItemViewModel>

@{
    bool isAdminView = ViewData["IsAdminView"] as bool? ?? false;
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No games available.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var game in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">

                    <img src="@game.ImagePath"
                         class="card-img-top"
                         style="height:240px; object-fit:cover;" />

                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="card-title fs-7 fw-bold">@game.Title</h5>

                            @if (game.AverageRating > 0)
                            {
                                <span class="badge bg-success fs-6 d-inline-flex align-items-center gap-1">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="gold" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                        <path d="M12 .587l3.668 7.431 8.2 1.193-5.934 5.787 1.4 8.168L12 18.897l-7.334 3.869 1.4-8.168L.132 9.211l8.2-1.193z" />
                                    </svg>
                                    @game.AverageRating.ToString("0.0") / 10
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">
                                    No reviews
                                </span>
                            }
                        </div>

                        <p class="card-text mt-2">@game.ShortDescription</p>

                        <div class="mt-auto d-flex gap-2 pt-3">
                            <a asp-area=""
                               asp-controller="Games"
                               asp-action="Details"
                               asp-route-id="@game.Id"
                               class="btn btn-primary flex-fill fw-semibold">
                                Details
                            </a>

                            <a asp-area=""
                               asp-controller="Reviews"
                               asp-action="ByGame"
                               asp-route-gameId="@game.Id"
                               class="btn btn-warning flex-fill fw-semibold">
                                💬 Reviews
                            </a>
                        </div>

                        @if (isAdminView)
                        {
                            <div class="d-flex gap-2 pt-2">
                                <a asp-area="Admin"
                                   asp-controller="Games"
                                   asp-action="EditGame"
                                   asp-route-id="@game.Id"
                                   class="btn btn-outline-primary flex-fill">
                                    Edit
                                </a>

                                <a asp-area="Admin"
                                   asp-controller="Games"
                                   asp-action="DeleteGame"
                                   asp-route-id="@game.Id"
                                   class="btn btn-outline-danger flex-fill">
                                    Delete
                                </a>
                            </div>
                        }

                    </div>
                </div>
            </div>
        }
    </div>
}