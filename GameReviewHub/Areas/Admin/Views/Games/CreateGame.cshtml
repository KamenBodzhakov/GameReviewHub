@using GameReviewHub.ViewModels.Game
@using GameReviewHub.ViewModels.Game.Admin
@model CreateGameViewModel

@{
    ViewData["Title"] = "Create Game";
}

<h2 class="mb-4">Create Game</h2>

<form asp-area="Admin"
      asp-controller="Games" 
      asp-action="CreateGame" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <partial name="_GameFormPartial" model="Model" />

    <button type="submit" class="btn btn-success">Create</button>
    <a asp-area="Admin" asp-controller="Games" asp-action="Index" class="btn btn-secondary">Cancel</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}