@using GameReviewHub.ViewModels.Game
@model CreateGameViewModel

@{
    ViewData["Title"] = "Create Game";
}

<h2 class="mb-4">Create Game</h2>

<form asp-area="Admin" asp-controller="Games" asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Developer" class="form-label"></label>
        <input asp-for="Input.Developer" class="form-control" />
        <span asp-validation-for="Input.Developer" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label"></label>
        <textarea asp-for="Input.Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ReleaseDate" class="form-label"></label>
        <input asp-for="Input.ReleaseDate" type="date" class="form-control"
               min="1970-01-01"
               max="2100-12-31" />
        <span asp-validation-for="Input.ReleaseDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ImagePath" class="form-label"></label>
        <input asp-for="Input.ImagePath" class="form-control" />
        <span asp-validation-for="Input.ImagePath" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label d-block">Genres</label>

        <div class="d-flex flex-wrap gap-3">
            @foreach (var genre in Model.AvailableGenres)
            {
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="Input.SelectedGenreIds"
                           value="@genre.Id"
                           @(Model.Input.SelectedGenreIds.Contains(genre.Id) ? "checked" : null) />
                    <label class="form-check-label">@genre.Name</label>
                </div>
            }
        </div>

        <span asp-validation-for="Input.SelectedGenreIds" class="text-danger d-block mt-2"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Create</button>
        <a asp-area="Admin" asp-controller="Games" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}