@using GameReviewHub.ViewModels.Game
@model GameReviewHub.ViewModels.Game.AllGamesQueryModel

@{
    ViewData["Title"] = "Manage Games";
    ViewData["IsAdminView"] = true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Manage Games</h2>

    <a asp-area="Admin"
       asp-controller="Games"
       asp-action="CreateGame"
       class="btn btn-success fw-semibold">
        + Add Game
    </a>
</div>

<form id="admin-games-filter-form" asp-action="Index" class="mb-4">
    <div class="row g-2">
        <div class="col-md-12">
            <input asp-for="SearchTerm"
                   id="admin-live-search-input"
                   class="form-control"
                   placeholder="Search games..." />
        </div>

    </div>
</form>

<div id="games-results">
    <partial name="_AdminGamesResultsPartial" model="Model" />
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("admin-games-filter-form");
            const searchInput = document.getElementById("admin-live-search-input");
            const resultsContainer = document.getElementById("games-results");

            let debounceTimer;

            form.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                }
            });

            async function loadResults(url = null, resetToFirstPage = false) {
                if (!url) {
                    const formData = new FormData(form);

                    if (resetToFirstPage) {
                        formData.set("CurrentPage", "1");
                    }

                    const query = new URLSearchParams(formData).toString();
                    url = `/Admin/Games/GetFilteredPagedGames?${query}`;
                }

                const response = await fetch(url);

                if (!response.ok) {
                    return;
                }

                const html = await response.text();
                resultsContainer.innerHTML = html;
            }

            searchInput.addEventListener("input", function () {
                clearTimeout(debounceTimer);

                debounceTimer = setTimeout(async function () {
                    await loadResults(null, true);
                }, 300);
            });

            resultsContainer.addEventListener("click", async function (e) {
                const link = e.target.closest("a.page-link");

                if (!link) {
                    return;
                }

                e.preventDefault();

                const linkUrl = new URL(link.href, window.location.origin);
                const url = `/Admin/Games/GetFilteredPagedGames${linkUrl.search}`;

                await loadResults(url);
            });
        });
    </script>
}
