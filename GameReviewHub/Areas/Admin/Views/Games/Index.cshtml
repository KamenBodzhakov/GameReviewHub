@using GameReviewHub.ViewModels.Game
@model GameReviewHub.ViewModels.Game.AllGamesQueryModel

@{
    ViewData["Title"] = "Manage Games";
    ViewData["IsAdminView"] = true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Manage Games</h2>

    <a asp-area="Admin"
       asp-controller="Games"
       asp-action="CreateGame"
       class="btn btn-success fw-semibold">
        + Add Game
    </a>
</div>

<form id="admin-games-filter-form" method="get" asp-action="Index" class="mb-4">
    <div class="row g-2">
        <div class="col-md-10">
            <input asp-for="SearchTerm"
                   id="admin-live-search-input"
                   class="form-control"
                   placeholder="Search games..." />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                Search
            </button>
        </div>
    </div>
</form>

<div id="games-results">
    <partial name="_AdminGamesResultsPartial" model="Model" />
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("admin-games-filter-form");
            const searchInput = document.getElementById("admin-live-search-input");
            const resultsContainer = document.getElementById("games-results");

            let debounceTimer;

            async function loadResults() {
                const formData = new FormData(form);
                formData.set("CurrentPage", "1");

                const query = new URLSearchParams(formData).toString();
                const url = `/Admin/Games/GetFilteredPagedGames?${query}`;

                const response = await fetch(url);

                if (!response.ok) {
                    return;
                }

                const html = await response.text();
                resultsContainer.innerHTML = html;
            }

            form.addEventListener("submit", async function (e) {
                e.preventDefault();
                await loadResults();
            });

            searchInput.addEventListener("input", function () {
                clearTimeout(debounceTimer);

                debounceTimer = setTimeout(async function () {
                    await loadResults();
                }, 300);
            });
        });
    </script>
}
