@using GameReviewHub.ViewModels.Game.Admin
@model DeleteGameViewModel

@{
    ViewData["Title"] = "Delete Game";
}

<h2 class="mb-4 text-danger">Delete Game</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this game?
</div>

<div class="card shadow-sm mb-4" style="max-width: 500px;">
    @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
    {
        <img src="@Model.ImagePath"
             class="card-img-top"
             style="height:240px; object-fit:cover;" />
    }

    <div class="card-body">
        <h4 class="card-title">@Model.Title</h4>
        <p class="card-text mb-1"><strong>Developer:</strong> @Model.Developer</p>
    </div>
</div>

<form asp-area="Admin"
      asp-controller="Games"
      asp-action="DeleteGame" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="GameId" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-area="Admin" asp-controller="Games" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>