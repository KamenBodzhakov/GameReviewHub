@model GameReviewHub.ViewModels.Game.AllGamesQueryModel

@{
    ViewData["IsAdminView"] = true;
}
<partial name="_GameCardsPartial" model="Model.Games" />

@{
    int previousPage = Model.CurrentPage - 1;
    if (previousPage < 1)
    {
        previousPage = 1;
    }

    int totalPages = Model.TotalPages;
}

@if (totalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-area="Admin"
                   asp-controller="Games"
                   asp-action="Index"
                   asp-route-currentPage="@previousPage"
                   asp-route-searchTerm="@Model.SearchTerm">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-area="Admin"
                       asp-controller="Games"
                       asp-action="Index"
                       asp-route-currentPage="@i"
                       asp-route-searchTerm="@Model.SearchTerm">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage == totalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-area="Admin"
                   asp-controller="Games"
                   asp-action="Index"
                   asp-route-currentPage="@(Model.CurrentPage + 1)"
                   asp-route-searchTerm="@Model.SearchTerm">
                    Next
                </a>
            </li>
        </ul>
    </nav>
}